# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). See SETUP.md for the full walkthrough.

# Public — safe to expose in the browser (used by lib/supabase/client.ts and server.ts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only, never exposed to the browser (used by lib/supabase/admin.ts
# inside /api/checkout). Do NOT prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used for metadataBase / absolute URLs in SEO tags. Defaults to
# https://shaashbeauty.com if unset.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Razorpay — from your Razorpay Dashboard: Settings -> API Keys. Both are
# server-only (used inside /api/checkout and /api/checkout/verify); neither
# is prefixed NEXT_PUBLIC_, so the secret never reaches the browser — the
# public key id is handed to the client per-request in the /api/checkout
# response instead. These are Test Mode keys until your account is KYC
# verified; switch to the Live Mode key pair from the same dashboard page
# when you're ready to take real payments — no code changes needed.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Telegram — sends a message to this chat every time a payment is
# successfully verified (see /api/checkout/verify). Both server-only.
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN; see SETUP.md for
# how to find TELEGRAM_CHAT_ID. Optional — if either is unset, order
# notifications are silently skipped and checkout still works normally.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
